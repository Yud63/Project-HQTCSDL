<%- include('../partials/header') %>
<h1>Tin nhắn</h1>
<%- include('_nav') %>
<% if (!convs.length) { %><div class="card empty">Chưa có tin nhắn nào.</div><% } else { convs.forEach(function(c){ %>
<div class="card" style="margin-bottom:16px">
  <h2 style="margin-top:0"><%= c.ListingTitle %></h2>
  <p class="muted">Trao đổi với <%= c.PartnerName %><% if (c.iAmSeller) { %> · <span class="badge">Tin của bạn</span><% } %></p>
  <% c.messages.forEach(function(m){ %>
  <p style="margin:6px 0;white-space:pre-wrap"><strong><%= m.IsMine ? 'Bạn' : c.PartnerName %></strong> <span class="muted"><%= new Date(m.SentAt).toLocaleString('vi-VN') %></span><br><%= m.Body %></p>
  <% }) %>
  <form method="post" action="/market/<%= c.ListingId %>/message" class="form" style="margin-top:12px">
    <input type="hidden" name="to" value="<%= c.PartnerId %>">
    <input type="hidden" name="from" value="messages">
    <label>Trả lời <textarea name="body" rows="2" maxlength="1000" required></textarea></label>
    <button class="btn btn-sm" type="submit">Gửi</button>
  </form>
</div>
<% }) } %>
<%- include('../partials/footer') %>