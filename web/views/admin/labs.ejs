<%- include('../partials/header') %>
<h1>Quản lý phòng Lab</h1>
<p class="muted">Tổng số phòng Lab: <%= total %></p>
<% if (!labs.length) { %><div class="card empty">Chưa có dữ liệu.</div><% } else { %>
<div class="table-wrap"><table class="table"><thead><tr><th>ID</th><th>Tên Lab</th><th>Chủ Lab</th><th>Thành phố</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
<% labs.forEach(function (lab) { %><tr>
<td><%= lab.LabId %></td><td><%= lab.LabName %></td><td><%= lab.OwnerName %></td><td><%= lab.City %></td>
<td><span class="badge <%= lab.ApprovalStatus === 'Approved' ? 'badge-success' : (lab.ApprovalStatus === 'Pending' ? 'badge-warning' : '') %>"><%= lab.ApprovalStatus %></span></td>
<td>
<% if (lab.ApprovalStatus === 'Pending') { %>
<form method="post" action="/admin/labs/<%= lab.LabId %>/approve" style="display:inline">
<input type="hidden" name="decision" value="Approved"><button class="btn btn-sm" type="submit">Duyệt</button>
</form>
<form method="post" action="/admin/labs/<%= lab.LabId %>/approve" style="display:inline">
<input type="hidden" name="decision" value="Rejected"><button class="btn btn-sm btn-outline" type="submit">Từ chối</button>
</form>
<% } else { %>Đã xử lý<% } %>
</td>
</tr><% }) %></tbody></table></div>
<% } %>
<%- include('../partials/footer') %>