
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Quản lý giao hàng</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f4f6fb;
            margin: 0;
            padding: 40px 20px;
        }
        .container {
            max-width: 1100px;
            margin: auto;
        }
        .card {
            background: white;
            padding: 24px;
            border-radius: 12px;
            box-shadow: 0 3px 10px #00000010;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }
        th, td {
            padding: 14px;
            border-bottom: 1px solid #eee;
            text-align: left;
        }
        th {
            background: #f1f4f9;
        }
        .status {
            font-weight: bold;
            color: #2563eb;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Quản lý giao hàng</h1>
        <p>Xin chào, <%= currentUser.name %>!</p>

        <div class="card">
            <h2>Đơn giao hàng của tôi</h2>

            <% if (deliveries && deliveries.length > 0) { %>
                <table>
                    <thead>
                        <tr>
                            <th>Mã giao hàng</th>
                            <th>Mã đơn</th>
                            <th>Loại giao</th>
                            <th>Trạng thái</th>
                            <th>Phí giao</th>
                            <th>Ngày tạo</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% deliveries.forEach(function(d) { %>
                            <tr>
                                <td>#<%= d.DeliveryRequestId %></td>
                                <td>#<%= d.OrderId %></td>
                                <td><%= d.Direction %></td>
                                <td class="status"><%= d.Status %></td>
                                <td><%= Number(d.Fee || 0).toLocaleString('vi-VN') %>đ</td>
                                <td><%= d.CreatedAt ? new Date(d.CreatedAt).toLocaleString('vi-VN') : '-' %></td>

<td>
    <% if (d.Status === 'Assigned') { %>
        <form method="POST" action="/delivery/<%= d.DeliveryRequestId %>/status">
            <input type="hidden" name="status" value="PickedUp">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit">Đã lấy hàng</button>
        </form>
    <% } else if (d.Status === 'PickedUp') { %>
        <form method="POST" action="/delivery/<%= d.DeliveryRequestId %>/status">
            <input type="hidden" name="status" value="Delivered">
            <button type="submit">Giao thành công</button>
        </form>

        <form method="POST" action="/delivery/<%= d.DeliveryRequestId %>/status">
            <input type="hidden" name="status" value="Failed">
            <input type="text" name="note" maxlength="255"
                   placeholder="Lý do giao thất bại" required>
            <button type="submit">Giao thất bại</button>
        </form>
    <% } else { %>
        <span>Không có thao tác</span>
    <% } %>
</td>

                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            <% } else { %>
                <p>Hiện tại bạn chưa có đơn giao hàng nào.</p>
            <% } %>
        </div>
    </div>
</body>
</html>
